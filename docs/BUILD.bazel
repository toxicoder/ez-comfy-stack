    name = "serve",
    srcs = ["manage-docs.sh"],
    args = ["serve"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "docs",
    srcs = ["manage-docs.sh"],
    args = ["build"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

# Generators only: fills docs/generated/ with no npm install and no webpack
# export. The four docs/generate_*.py scripts were reachable only through the
# full site build, so the cheap "I edited a shell function, refresh the
# reference" loop meant running python3 by hand.
sh_binary(
    name = "generate",
    srcs = ["manage-docs.sh"],
    args = ["generate"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

# One generator per target, so the edit-run-print loop over a single derived
# file stays Bazel-first. Each forwards `generate-one <module>` to
# manage-docs.sh, which names the module it runs.
sh_binary(
    name = "generate_shell",
    srcs = ["manage-docs.sh"],
    args = [
        "generate-one",
        "generate_shell_docs",
    ],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "generate_workflow",
    srcs = ["manage-docs.sh"],
    args = [
        "generate-one",
        "generate_workflow_docs",
    ],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

