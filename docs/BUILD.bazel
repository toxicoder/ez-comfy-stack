    name = "render-check",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "test_docs_site_render",
    size = "medium",
    timeout = "moderate",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
        "//:CONTRIBUTING.md",
        "//:README.md",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)
