"""Package purpose: Documentation content package - markdown/MDX pages, generators, and the Bazel entry points that drive the Fumadocs site in docs-site/.

The site itself is the Next.js app in `docs-site/` (see that package for the npm runners).
This package owns the *content*: the pages under `docs/`, the generators that fill
`docs/generated/`, and the Python gates around them.

Usage:
  bazelisk run //docs:serve
  bazelisk run //docs:docs
  bazelisk run //docs:preview
  bazelisk run //docs:status
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "content",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
            "assets/**",
            "generated/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

_DOCS_COMMON_DATA = [
    "generate_shell_docs.py",
    "generate_workflow_docs.py",
    "generate_cinema_docs.py",
    "cinema_clip_prompts.py",
    "generate_audio_docs.py",
    "glossary.py",
    "page_brief.py",
    "commands.py",
    "requirements.txt",
    "setup-docs.sh",
    ":content",
    "//includes",
    "//scripts:doc_sources",
] + glob(
    ["workflow_nodes*.py"],
    allow_empty = True,
)

sh_binary(
    name = "serve",
    srcs = ["manage-docs.sh"],
    args = ["serve"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "docs",
    srcs = ["manage-docs.sh"],
    args = ["build"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "preview",
    srcs = ["manage-docs.sh"],
    args = ["preview"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "status",
    srcs = ["manage-docs.sh"],
    args = ["status"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "clean",
    srcs = ["manage-docs.sh"],
    args = ["clean"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "render-check",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "test_docs_site_render",
    size = "medium",
    timeout = "moderate",
    srcs = ["test_docs_site_render.sh"],
    data = [
        "test_docs_site_render.py",
        "test_docs_site_render.sh",
        ":content",
        "//:CONTRIBUTING.md",
        "//:README.md",
        "//docs-site:sources",
    ],
    visibility = ["//visibility:public"],
)
