"""Package purpose: MkDocs site serve/build binaries and a strict-build test."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

_DOCS_COMMON_DATA = [
    "generate_shell_docs.py",
    "generate_workflow_docs.py",
    "generate_cinema_docs.py",
    "glossary.py",
    "hooks.py",
    "page_brief.py",
    "commands.py",
    "workflow_nodes.py",
    "requirements.txt",
    "//:mkdocs.yml",
    "//includes",
    "//scripts:doc_sources",
] + glob(
    ["**/*.md"],
    allow_empty = True,
) + glob(
    ["javascripts/*"],
    allow_empty = True,
) + glob(
    ["stylesheets/*"],
    allow_empty = True,
)

sh_binary(
    name = "serve",
    srcs = ["manage-docs.sh"],
    args = ["serve"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "docs",
    srcs = ["manage-docs.sh"],
    args = ["build"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "preview",
    srcs = ["manage-docs.sh"],
    args = ["preview"],
    data = _DOCS_COMMON_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "status",
    srcs = ["manage-docs.sh"],
    args = ["status"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "clean",
    srcs = ["manage-docs.sh"],
    args = ["clean"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "test_mkdocs_build",
    size = "large",
    timeout = "moderate",
    srcs = ["manage-docs.sh"],
    args = ["build"],
    data = _DOCS_COMMON_DATA,
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)
