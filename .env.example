# Copy to .env and adjust for your Spark host.
# Never commit real tokens.

# Shared model cache (same default as nvidia-dgx-spark-lab).
# Must be writable by your user:
#   sudo mkdir -p /mnt/models && sudo chown "$USER:$USER" /mnt/models
# Or set e.g. MODELS_DIR=$HOME/models
MODELS_DIR=/mnt/models

# Hugging Face token for gated FLUX / LTX licenses (optional if already logged in)
# HF_TOKEN=

# ComfyUI host port
COMFY_PORT=8188

# Docker memory for the unified flux-to-ltx stack (leave headroom for SSH/OS)
MEM_LIMIT=90g
MEM_RESERVATION=80g

# CUDA images for docker compose build (public Docker Hub; no NGC login).
# Multi-stage: devel builder + runtime final. Optional NGC after: docker login nvcr.io
# CUDA_BASE_IMAGE=nvidia/cuda:13.0.0-devel-ubuntu24.04
# CUDA_RUNTIME_IMAGE=nvidia/cuda:13.0.0-runtime-ubuntu24.04
# CUDA_BASE_IMAGE=nvcr.io/nvidia/cuda:13.0.0-devel-ubuntu24.04
# CUDA_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:13.0.0-runtime-ubuntu24.04

# Prebuilt app image (GHCR only — no Docker Hub). Contains Comfy+torch, NOT model weights.
# EZ_COMFY_IMAGE=ghcr.io/toxicoder/ez-comfy:flux-to-ltx
# LAB_STACK_FORCE_BUILD=1   # ignore pull; build Dockerfile locally
# LAB_STACK_SKIP_PULL=1     # do not docker pull
# LAB_FORCE_COLD_INSTALL=1  # ignore /opt/comfy-prebuilt; full pip at runtime
# EZ_COMFY_PREBUILD=1       # bake Comfy+torch when building (default 1)

# Host free-memory headroom required before start (GiB). Default 28 leaves ~SSH-safe room on 128GB Spark.
MIN_HOST_FREE_GIB=28

# Download bandwidth limit for manage.sh download-models:
#   auto  — speedtest then 85% of measured download Mbps (default)
#   off   — no throttle (not recommended over remote SSH)
#   <N>   — fixed Mbps, e.g. 50
DOWNLOAD_LIMIT=auto

# Fallback Mbps when auto speedtest fails
DOWNLOAD_LIMIT_FALLBACK=50

# Non-interactive automation (CI / scripts):
# LAB_NON_INTERACTIVE=1
# LAB_CONFIRM_TOKEN=yes
