"""Package purpose: Compose, Dockerfile, entrypoint, install-comfy, and Spark patches."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = [
        ".dockerignore",
        "Dockerfile",
        "compose_config_test.sh",
        "docker-compose.yml",
        "entrypoint.sh",
        "install-comfy.sh",
        "install-comfy/chatterbox-tts.sh",
        "install-comfy/common.sh",
        "install-comfy/core.sh",
        "install-comfy/llama-cpp-cpu.sh",
        "install-comfy/phase-comfy.sh",
        "install-comfy/phase-finalize.sh",
        "install-comfy/phase-nodes.sh",
        "install-comfy/phase-venv-torch.sh",
        "install-comfy/qwen-tts.sh",
        "patch_common.py",
        "patch_get_free_memory.py",
        "patch_magcache_compat.py",
        "patch_unified_memory_copy.py",
        "patch_vhs_widget_inputs.py",
        "pythonpath/sitecustomize.py",
        "seed_clay_inputs.py",
    ],
)

# docker compose config -q: parse and validate the compose file the stack
# actually starts. It catches a broken anchor, a duplicate key, or a service
# that no longer resolves, which no other gate here reads. check_tool skips the
# run when no docker CLI is installed (this guard is about the file, not the
# daemon), and //lints gates are the ones that fail loudly on a missing tool.
sh_test(
    name = "compose_config",
    size = "medium",
    timeout = "short",
    srcs = ["compose_config_test.sh"],
    data = [
        "docker-compose.yml",
        ":sources",
        "//scripts:lib/check_tool.sh",
    ],
    tags = [
        "compose",
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)
