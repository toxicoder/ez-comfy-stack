oard"],"type":"text","url":"/learn/clay-to-finish#occupancy","content":"Playbook details: DCC guide pack. Shot YAML: 90s shorts. Apps: ComfyUI Apps."},"3289":{"id":"/learn/comfy-first-blender","page_id":"/learn/comfy-first-blender","type":"page","content":"Stay in Comfy after a Blender dump","breadcrumbs":["Docs","How the studio works"],"tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"url":"/learn/comfy-first-blender"},"3290":{"id":"/learn/comfy-first-blender-0","page_id":"/learn/comfy-first-blender","tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"type":"text","url":"/learn/comfy-first-blender","content":"Load a host Blender guide pack on the Comfy canvas, Klein-look a plate, gate occupancy, and hand off to LTX or TRELLIS without leaving :8188."},"3291":{"id":"/learn/comfy-first-blender-1","page_id":"/learn/comfy-first-blender","type":"heading","tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"url":"/learn/comfy-first-blender#stay-in-comfy-after-a-blender-dump","content":"Stay in Comfy after a Blender dump"},"3292":{"id":"/learn/comfy-first-blender-2","page_id":"/learn/comfy-first-blender","type":"heading","tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"url":"/learn/comfy-first-blender#operator-loop","content":"Operator loop"},"3293":{"id":"/learn/comfy-first-blender-3","page_id":"/learn/comfy-first-blender","type":"heading","tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"url":"/learn/comfy-first-blender#graphs-_labdcc","content":"Graphs (`_lab/dcc/`)"},"3294":{"id":"/learn/comfy-first-blender-4","page_id":"/learn/comfy-first-blender","type":"heading","tags":["learn","blender","dcc","comfyui","occupancy","klein","ltx","trellis"],"url":"/learn/comfy-first-blender#path-d-default-on-one-gb10","content":"Path D (default on one GB10)"},"3295":{"id":"/learn/comfy-first-blender-5","page_id":"/learn/comfy-first-blender"