pe"},"3583":{"id":"/learn/pipeline-15","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#klein-wan-and-ltx","content":"**Who this is for:** studio users who have Queued `stills/still-draft` once."},"3584":{"id":"/learn/pipeline-16","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Model"},"3585":{"id":"/learn/pipeline-17","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Job"},"3586":{"id":"/learn/pipeline-18","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Encoder"},"3587":{"id":"/learn/pipeline-19","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"License"},"3588":{"id":"/learn/pipeline-20","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"**Klein 4B** distilled FP8"},"3589":{"id":"/learn/pipeline-21","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Still (T2I, optional edit)"},"3590":{"id":"/learn/pipeline-22","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Qwen3-4B · `flux2`"},"3591":{"id":"/learn/pipeline-23","page_id":"/learn/pipeline","tags":["learn","klein","wan","ltx","pipeline","us-safe"],"type":"text","url":"/learn/pipeline#three-jobs-three-licenses","content":"Apache 2.0"},"3592":{"id":"/learn/pipeline-24","page_id"