n","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#image-and-video-generation","content":"Avoiding the two classic Spark-melters: 720p on LTX, and a 90 s latent"},"3408":{"id":"/learn/generation-14","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#image-and-video-generation","content":"**Who this is for:** studio users who can Queue a still and want to know *why* the widgets look like that."},"3409":{"id":"/learn/generation-15","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Every lab still or clip is the same shape:"},"3410":{"id":"/learn/generation-16","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Piece"},"3411":{"id":"/learn/generation-17","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Job in this studio"},"3412":{"id":"/learn/generation-18","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"**CLIP**"},"3413":{"id":"/learn/generation-19","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Turns words into conditioning. Klein uses Qwen (`flux2`), Wan uses UMT5 (`wan`), LTX uses Gemma4-with-proj (`ltxv`)"},"3414":{"id":"/learn/generation-20","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"**Denoiser**"},"3415":{"id":"/learn/generation-21","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Walks noise toward a sample for N **steps** at a **CFG** and **seed**"},"3416":{"id":"/learn/generation-22","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"**VAE**"},"3417":{"id":"/learn/generation-23","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Decodes latents to pixels (and LTX audio). Each family has its own VAE — do not mix"},"3418":{"id":"/learn/generation-24","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#three-boxes","content":"Wrong CLIP type on a Klein graph is a Queue error, not a “bad prompt.”"},"3419":{"id":"/learn/generation-25","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"The sampler does not paint a PNG directly. It denoises a **latent** tensor. Width, height, and frame count are latent widgets."},"3420":{"id":"/learn/generation-26","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Goal"},"3421":{"id":"/learn/generation-27","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Lab default"},"3422":{"id":"/learn/generation-28","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Why"},"3423":{"id":"/learn/generation-29","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Fast still"},"3424":{"id":"/learn/generation-30","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Klein draft **768×432**, 4 steps"},"3425":{"id":"/learn/generation-31","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"Minutes, not a hero"},"3426":{"id":"/learn/generation-32","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"I2V feeder / LTX"},"3427":{"id":"/learn/generation-33","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"**1280×704**"},"3428":{"id":"/learn/generation-34","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"LTX VAE is **÷32**. 1280×720 is not (720/16=45)"},"3429":{"id":"/learn/generation-35","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"\\~5 s Wan / \\~12 s LTX App"},"3430":{"id":"/learn/generation-36","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-where-size-lives","content":"LTX Apps **289** frames (`1+8n`) @ 24 fps ≈ **12.04 s**; film printers **121** ≈ **5.04 s**; Wan shot **120** = **5.00 s**"},"3431":{"id":"/learn/generation-37","page_id":"/learn/generation","tags":["learn","diffusion","latent","vae","clip","comfyui"],"type":"text","url":"/learn/generation#latents-are-