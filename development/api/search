roubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"`IndentationError` in `model_management.py` / `mem_free_torch`"},"4342":{"id":"/operate/troubleshooting-start-runtime-64","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"Old free-memory patch broke indent"},"4343":{"id":"/operate/troubleshooting-start-runtime-65","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"Pull latest (patch is bind-mounted). `./scripts/manage.sh stop && ./scripts/manage.sh start` — auto-repairs via git restore + re-patch. No full image rebuild required"},"4344":{"id":"/operate/troubleshooting-start-runtime-66","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"Cold start forever"},"4345":{"id":"/operate/troubleshooting-start-runtime-67","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"First PVC/volume pip+git"},"4346":{"id":"/operate/troubleshooting-start-runtime-68","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","comfyui"],"type":"text","url":"/operate/troubleshooting-start-runtime#start--runtime","content":"Wait; `manage.sh logs`; check network"},"4347":{"id":"/operate/troubleshooting-start-runtime-69","page_id":"/operate/troubleshooting-start-runtime","tags":["troubleshooting","start","docker","kitchen","com