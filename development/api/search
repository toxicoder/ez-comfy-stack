fyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"**Star via QSFP switch:** each Spark one or two 200 GbE links."},"1552":{"id":"/spark-farm-47","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"Management SSH stays on 10 GbE / RJ45. Model sync uses **`SPARK_FABRIC_IPS` only**. Do not rsync multi-gig weights over the management NIC."},"1553":{"id":"/spark-farm-48","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"Shared `MODELS_DIR` (pick one):"},"1554":{"id":"/spark-farm-49","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"**NFS over the fabric subnet (preferred):** Spark-0 exports `${MODELS_DIR}` (default `/mnt/models`); Sparks 1–2 mount it. Compose already bind-mounts `${MODELS_DIR}:/models`."},"1555":{"id":"/spark-farm-50","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"**Replica:** `./scripts/utilities/spark-farm.sh sync-models` rsyncs `MODELS_DIR/comfy` over fabric IPs."},"1556":{"id":"/spark-farm-51","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#networking-docs-only--no-iac","content":"Copy `config/spark-farm.example.env`, edit hostnames/IPs, then:"},"1557":{"id":"/spark-farm-52","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"On **each** Spark (operator, with confirm):"},"1558":{"id":"/spark-farm-53","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"Three UIs (replace hostnames from `SPARK_COMFY_URLS`):"},"1559":{"id":"/spark-farm-54","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"The one-click **films/go-see** graph is sequential on one host. For a farm, load **motion/av/still-to-shot** (or optional **motion/silent/still-to-shot**) on each UI and **Queue** independent **5 s** shots — different beats in parallel. Concat locally:"},"1560":{"id":"/spark-farm-55","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"See 90s shorts. MiniMax H3 films are banned (see licenses)."},"1561":{"id":"/spark-farm-56","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"`spark-farm.sh` **never** starts compose remotely. It prints the exact `./scripts/manage.sh start` you must run locally (heavy confirm stays on that node). Containers still use `restart: \"no\"`."},"1562":{"id":"/spark-farm-57","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"The `run` subcommand prints a **films/go-see / motion/silent/still-to-shot / motion/av/still-to-shot** Queue reminder for `--film go-see` (or still-here / switchyard). It does **not** POST graphs. It refuses MiniMax H3 names (`*h3*` / `*MiniMax*`)."},"1563":{"id":"/spark-farm-58","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"`dispatch` assigns shots **01–06 / 07–12 / 13–18** (or an even split on two hosts) and SSH-runs **local** `./scripts/manage.sh print-shot` on each Spark. It **never** remote-starts compose. Director is off this path. Concat on spark-0 after gather."},"1564":{"id":"/spark-farm-59","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#per-node-process","content":"Memory: keep `MEM_LIMIT=90g`, `MEM_RESERVATION=80g`, `MIN_HOST_FREE_GIB=28`, `shm_size: 16gb`."},"1565":{"id":"/spark-farm-60","page_id":"/spark-farm","tags":["spark","farm","fabric","comfyui"],"type":"text","url":"/spark-farm#commands","content":"Start compose yourself on each node (`./scripts/manage.sh start`, type yes). Then dispatch."},"1566":{"id":"/splat-sidecar","page_id":"/splat-sidecar","type":"page","content":"Splat sidecar","breadcrumbs":["Docs"],"tags":["splat","supersplat","sidecar","occupancy"],"url":"/splat-sidecar"},"1567":{"id":"/splat-sidecar-0","page_id":"/splat-sidecar","tags":["splat","supersplat","sidecar","occupancy"],"type":"text","url":"/splat-sidecar","content":"SuperSplat MIT host viewer for Gaussian splats. Not in the Dockerfile. Occupancy with Comfy."},"1568":{"id":"/splat-sidecar-1","page_id":"/splat-sidecar","type":"heading","tags":["splat","supersplat","sidecar","occupancy"],"url":"/splat-sidecar#splat-sidecar","content":"Splat sidecar"},"1569":{"id":"/splat-sidecar-2","page_id":"/splat-sidecar","type":"heading","tags":["splat","supersplat","sidecar","occupancy"],"url":"/splat-sidecar#operator-path","content":"Operator path"},"1570":{"id":"/splat-sidecar-3","page_id":"/splat-sidecar","tags":["splat","supersplat","sidecar","occupancy"],"type":"text","url":"/splat-sidecar#splat-sidecar","content":"**What's on this page**"},"1571":{"id":"/splat-sidecar-4","page_id":"/splat-sidecar","tags":["splat","supersplat","sidecar","occupancy"],"type":"text","url":"/splat-sidecar#splat-sidecar","content":"SuperSplat as a **host** static viewer (MIT)"},"1572":{"id":"/splat-sidecar-5","page_id":"/splat-sidecar","tags":["splat","supersplat","sidecar","occupancy"],"type":"text","url":"/splat-sidecar#splat-sidecar","content":"Why it is not in `docker/Dockerfile`"},"1573":{"id":"/splat-sidecar-6","page_id":"/splat-sidecar","tags":["splat","supersplat","sidecar","occupancy"],"type":"text","url":"/splat-sidecar#splat-sidecar","content":"Occupancy with Comfy / TRELLIS"},"1574":{"id":"/splat-sidecar-7","page_id":"/splat-sidecar","tags":["s