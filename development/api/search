ags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#occupancy-desk","content":"Parked Comfy is **not** a second denoise. `blender-desk` is Workbench / CPU after models unload. `llm-desk` is the host 35B llama-server after models unload — that sidecar **is** the GPU job. Cycles CUDA, TRELLIS, Wan, LTX, and llm-desk still XOR with each other. This does **not** weaken `restart: \"no\"`, headroom, or download-limit clear-on-exit."},"1052":{"id":"/occupancy-19","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"Mode"},"1053":{"id":"/occupancy-20","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"Compose"},"1054":{"id":"/occupancy-21","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"Comfy weights"},"1055":{"id":"/occupancy-22","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"35B sidecar"},"1056":{"id":"/occupancy-23","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"GPU job"},"1057":{"id":"/occupancy-24","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"`idle`"},"1058":{"id":"/occupancy-25","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"down"},"1059":{"id":"/occupancy-26","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"—"},"1060":{"id":"/occupancy-27","page_id":"/occupancy","tags":["occupancy","blender","trellis","safety","gb10"],"type":"text","url":"/occupancy#modes","content":"**stopped**"},"1061":{"id