  "extra": {
    "lab_profile": "creator/stills/instagram-grid-3up",
    "lab_note": "## creator/stills/instagram-grid-3up\n\nFormat / platform sets pixels (Custom uses Width \u00d7 Height). Quality does not change size.\n\nInstagram 1:1 three-tile grid row. Lab size **1024\u00d71024**. Prefix `ez_ig_g01`.\nEmpty of lettering. Add titles in your editor, not in the prompt.\nOccupancy: klein \u2014 stop Wan, LTX, podcast, music. One GB10 job.\nHandoff: none.\nPack prefixes: `ez_ig_g01`, `ez_ig_g02`, `ez_ig_g03`.\nPrompt enhance is on by default (on-box Qwen3-4B-Instruct-2507). After Queue, the Enhance node shows the prompt CLIP used (or a passthrough reason). Turn Enhance off to use the widget text as-is. Optional style dropdown.\n",
    "lab_description": "Instagram 1:1 three-tile grid row",
    "lab_rel": "creator/stills/instagram-grid-3up",
    "workflowRendererVersion": "Vue-corrected",
    "lab_app_mode": {
      "enabled": true,
      "default_view": "app",
      "frontend_min": "1.41.13",
      "lane": "produce",
      "occupancy": "klein",
      "enhance_off_identity": false,
      "handoff": []
    },
    "linearData": {
