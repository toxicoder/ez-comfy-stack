"""Package purpose: Shipped _lab Comfy graphs and shorts YAML (never _user dumps)."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "lab_graphs",
    srcs = [
        "quality/ltx-2.5/NOTICE.md",
        "shorts/breakwater.shots.yaml",
        "shorts/glasshouse.shots.yaml",
        "shorts/go-see.shots.yaml",
        "shorts/last-lane.shots.yaml",
        "shorts/night-oven.shots.yaml",
        "shorts/still-here.shots.yaml",
        "shorts/switchyard.shots.yaml",
        "shorts/tide-table.shots.yaml",
    ] + glob(
        [
            "_lab/**/*.json",
        ],
        allow_empty = False,
    ),
)
