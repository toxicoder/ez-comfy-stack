"""Package purpose: manage.sh operational binary, utility scripts, validate orchestrator, and doc sources."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

exec_shell(
    name = "manage",
    src = "manage.sh",
    data = [
        ":doc_sources",
        "//config:policy",
        "//docker:sources",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "update-stack",
    src = "utilities/update-stack.sh",
    data = [
        ":doc_sources",
        "//config:policy",
        "//docker:sources",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "manage_help_test",
    size = "small",
    srcs = ["manage.sh"],
    args = ["help"],
    data = [
        ":doc_sources",
        "//config:policy",
        "//docker:sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "manage.sh",
        "setup-host.sh",
        "validate.sh",
        "ci_check_only.sh",
    ] + glob(
        ["lib/*.sh"],
        allow_empty = False,
    ) + glob(
        ["lib/*.py"],
        allow_empty = False,
    ) + glob(
        ["utilities/*.sh"],
        allow_empty = False,
    ) + glob(
        ["utilities/*.ps1"],
        allow_empty = False,
    ) + glob(
        ["ci/*.sh"],
        allow_empty = False,
    ),
    visibility = [
        "//docs:__pkg__",
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "doc_sources",
    srcs = [
        "manage.sh",
        "validate.sh",
    ] + glob(
        ["lib/*.sh"],
        allow_empty = False,
    ) + glob(
        ["lib/*.py"],
        allow_empty = False,
    ) + glob(
        ["utilities/*.sh"],
        allow_empty = False,
    ),
    visibility = [
        "//docs:__pkg__",
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "utilities",
    srcs = glob(
        ["utilities/*.sh"],
        allow_empty = False,
    ) + glob(
        # The Windows client bootstrap: same lane as setup-client.sh, run from
        # a PowerShell prompt on a Spark client. It is a payload of the
        # utility runner, not of manage.sh.
        ["utilities/*.ps1"],
        allow_empty = False,
    ) + glob(
        ["lib/*.sh"],
        allow_empty = False,
    ) + glob(
        ["lib/*.py"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "run-utility",
    src = "utilities/runner.sh",
    data = [":utilities"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "validate",
    srcs = ["validate.sh"],
    data = [
        "ci_check_only.sh",
        "lib/paths.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_install_lint_tools",
    srcs = ["ci/install-lint-tools.sh"],
    visibility = ["//visibility:public"],
)

# Both lint-tool installers: the implementation here and the thin
# .github/scripts wrapper the GitHub action path uses. They are not duplicates
# (the wrapper execs this script), so both stay and both are mapped.
filegroup(
    name = "ci_lint_tools",
    srcs = [
        "ci/install-lint-tools.sh",
        "//:.github/scripts/install-lint-tools.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_publish_pages_tree",
    srcs = ["ci/publish-pages-tree.sh"],
    visibility = ["//visibility:public"],
)
