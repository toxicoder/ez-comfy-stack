        "setup-host.sh",
        "everything.sh",
        "validate.sh",
        "ci_check_only.sh",
    ] + _LIB_SH + _LIB_PY + _UTILITIES_SH + _UTILITIES_PS1 + _CI_SH,
    visibility = [
        "//docs:__pkg__",
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "doc_sources",
    srcs = [
        "manage.sh",
        "validate.sh",
    ] + _LIB_SH + _LIB_PY + _UTILITIES_SH,
    visibility = [
        "//docs:__pkg__",
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "utilities",
    srcs = _UTILITIES_SH + [
        # The Windows client bootstrap: same lane as setup-client.sh, run from
        # a PowerShell prompt on a Spark client. It is a payload of the
        # utility runner, not of manage.sh.
        "utilities/setup-client.ps1",
    ] + _LIB_SH + _LIB_PY,
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "run-utility",
    src = "utilities/runner.sh",
    data = [":utilities"],
    visibility = ["//visibility:public"],
)

# The guarded operator console. Its own target rather than a manage.sh verb: the
# console is the operator surface, so it gets an ingress of its own beside
# //:manage, and the catalog that backs it is checked for covering every manage.sh
# verb (tests/python/test_tui_catalog.py), which a self-referential verb would
# break. The launcher dispatches from the git checkout via bazel_checkout_root,
# so the runfiles copy is only a fallback; the lab graphs and custom_nodes
# sources ride along for a checkout that cannot be found.
exec_shell(
    name = "studio-tui",
    src = "utilities/studio-tui.sh",
    data = [
        ":utilities",
        "//config:policy",
        "//custom_nodes:sources",
        "//docker:sources",
        "//workflows:lab_graphs",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "validate",
    srcs = ["validate.sh"],
    data = [
        "ci_check_only.sh",
        "lib/paths.sh",
    ],
    visibility = ["//visibility:public"],
)

# The full-sweep orchestrator behind //:everything. It shells out to bazelisk
# only, so the single lib it carries is the bug-report handoff gate() prints
# when a bazelisk gate fails.
exec_shell(
    name = "everything",
    src = "everything.sh",
    data = ["lib/bug_report.sh"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_install_lint_tools",
    srcs = ["ci/install-lint-tools.sh"],
    visibility = ["//visibility:public"],
)

# Both lint-tool installers: the implementation here and the thin
# .github/scripts wrapper the GitHub action path uses. They are not duplicates
# (the wrapper execs this script), so both stay and both are mapped.
filegroup(
    name = "ci_lint_tools",
    srcs = [
        "ci/install-lint-tools.sh",
        "//:.github/scripts/install-lint-tools.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_publish_pages_tree",
    srcs = ["ci/publish-pages-tree.sh"],
    visibility = ["//visibility:public"],
)
