# ## Dev / CI tool version pins (single source of truth)
#
# Sourced by:
#   - .devcontainer/Dockerfile (ARG defaults; do not COPY this file into early layers)
#   - .devcontainer/doctor.sh
#   - scripts/ci/install-lint-tools.sh
#   - .github/actions/setup-bazel (cache keys should match these pins)
#
# Format: KEY=value (no spaces around =). BASH-sourceable.

# Bazelisk downloads Bazel from .bazelversion (currently 8.4.1).
BAZELISK_VERSION=v1.25.0
BUILDIFIER_VERSION=v8.2.1
SHFMT_VERSION=v3.10.0
# shfmt release asset embeds the version without a leading "v".
SHFMT_ASSET_VERSION=3.10.0
PYTHON_VERSION=3.12
# Official nodejs.org linux-{x64,arm64} tarball (not the Node Feature).
NODE_VERSION=22.23.2
NODE_SHA256_X64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
NODE_SHA256_ARM64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8
# Grok Build CLI (https://x.ai/cli/stable). linux-x86_64 + linux-aarch64 only.
GROK_VERSION=1.0.40
