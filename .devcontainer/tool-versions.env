# Dev / CI tool version pins (single source of truth).
#
# What this is: the one place the contributor and CI toolchain versions are
#   declared, so a bump is one edit instead of four.
# Copy and edit: nothing to copy - it is tracked and you edit it in a branch.
#   Sourced by:
#     - .devcontainer/Dockerfile (ARG defaults; the file must never be COPYed
#       into an early layer, that would bust the apt cache layer)
#     - .devcontainer/doctor.sh
#     - scripts/ci/install-lint-tools.sh (BUILDIFIER_VERSION and
#       SHFMT_ASSET_VERSION are hard-required with :? - dropping either fails CI)
#     - .github/actions/setup-bazel (its cache keys hash this file)
#   .devcontainer/devcontainer.json passes the same values as build args, so
#   bump it in the same change.
# Never commit the real file: not applicable - this file is the tracked one and
#   carries only public release versions, no tokens.
# Layout: sections are the `# ---` banners. Every pin needs a reader (a
#   Dockerfile ARG, install-lint-tools.sh, or doctor.sh); an unconsumed pin is
#   dead weight and gets removed, which is why there is no shfmt-version or
#   Python-version pin here (shfmt is pinned by asset name only, and Python
#   comes from apt python3-venv).
# Format: KEY=value, no spaces around `=`, BASH-sourceable. Tests source it
#   with set -a and assert the 7 keys below are non-empty, then grep each value
#   back out of the Dockerfile (tests/bats/devcontainer.bats:18,43-53).
# Long-form docs: docs/contribute/devcontainer.md

# --- Bazel ----------------------------------------------------------------

# BAZELISK_VERSION - Bazelisk release that resolves Bazel itself; the Bazel
#   version is a separate pin in .bazelversion (currently 8.4.1).
# Set: the latest Bazelisk release tag (leading v). Bump .bazelversion on its
#   own when the build needs a newer Bazel.
BAZELISK_VERSION=v1.25.0

# --- Shell lint -----------------------------------------------------------

# BUILDIFIER_VERSION - buildifier release used to format BUILD / MODULE files;
#   scripts/ci/install-lint-tools.sh:39 aborts when it is unset.
# Set: the latest buildifier release tag (leading v), matching the bazel tooling.
BUILDIFIER_VERSION=v8.2.1

# SHFMT_ASSET_VERSION - shfmt release used to format shell;
#   scripts/ci/install-lint-tools.sh:40 aborts when it is unset. The release
#   asset embeds the version without a leading "v", so this pin carries digits
#   only (release v3.10.0 -> asset 3.10.0).
# Set: the shfmt release you want, digits only; keep it in step with the
#   shfmt checks in //:lint.
SHFMT_ASSET_VERSION=3.10.0

# --- Node -----------------------------------------------------------------

# Official nodejs.org linux-{x64,arm64} tarballs, not the Node devcontainer
#   feature - the checksums below are what make that download reproducible.

# NODE_VERSION - Node release baked into the devcontainer (node + npm); the
#   docs-site npm install is the main consumer.
# Set: an LTS line; change the two checksums in the same commit.
NODE_VERSION=22.23.2

# NODE_SHA256_X64 / NODE_SHA256_ARM64 - sha256 of the official linux-x64 and
#   linux-arm64 tarballs for NODE_VERSION.
# Set: copy both from the nodejs.org SHASUMS256.txt for that exact release;
#   never reuse the previous release's values.
NODE_SHA256_X64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
NODE_SHA256_ARM64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

# --- Grok CLI -------------------------------------------------------------

# GROK_VERSION - Grok Build CLI release baked into the devcontainer
#   (https://x.ai/cli/stable); artifacts exist for linux-x86_64 and
#   linux-aarch64 only.
# Set: the current stable release from that channel.
GROK_VERSION=1.0.40
