{
  "name": "ez-comfy-stack",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "cacheFrom": [
      "ghcr.io/toxicoder/ez-comfy-devcontainer:development"
    ],
    "args": {
      "BAZELISK_VERSION": "v1.25.0",
      "BUILDIFIER_VERSION": "v8.2.1",
      "SHFMT_ASSET_VERSION": "3.10.0",
      "NODE_VERSION": "22.23.2",
      "GROK_VERSION": "1.0.40"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "moby": true
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "init": true,
  "capDrop": [
    "SYS_ADMIN",
    "SYS_MODULE",
    "SYS_PTRACE",
    "NET_ADMIN",
    "NET_RAW",
    "MKNOD"
  ],
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "mounts": [
    "source=ez-comfy-bazel-disk,target=/home/vscode/.cache/bazel-disk,type=volume",
    "source=ez-comfy-bazel-repo,target=/home/vscode/.cache/bazel-repo,type=volume",
    "source=ez-comfy-pip,target=/home/vscode/.cache/pip,type=volume"
  ],
  "containerEnv": {
    "GROK_SANDBOX": "devcontainer",
    "HOST_LLM_BASE_URL": "http://host.docker.internal:11434/v1"
  },
  "remoteEnv": {
    "XAI_API_KEY": "${localEnv:XAI_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bazelbuild.vscode-bazel",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "mkhl.shfmt",
        "timonwong.shellcheck"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "bazel.executable": "/usr/local/bin/bazelisk",
        "bazel.buildifierExecutable": "/usr/local/bin/buildifier",
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.analysis.diagnosticMode": "openFilesOnly",
        "python.testing.autoTestDiscoverOnSaveEnabled": false,
        "mypy-type-checker.reportingScope": "file",
        "bazel.queriesShareServer": false,
        "bazel.enableCodeLens": false,
        "bazel.enableWorkspaceTree": false
      }
    }
  },
  "forwardPorts": [3005, 8188],
  "portsAttributes": {
    "3005": { "label": "Fumadocs", "onAutoForward": "notify" },
    "8188": { "label": "ComfyUI", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
