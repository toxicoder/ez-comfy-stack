#!/usr/bin/env bats
#
# Hermetic tests for tests/build_quality_js.sh, the Bazel entry point for the
# Quality tier codegen (//tests:build_quality_js and //tests:build_quality_js_check).
#
# The write and drift cases run against a scratch tree staged with the real
# presets.py, so the checkout's generated file is never touched.

load 'test_helper'

setup() {
  setup_repo_env
  WRAPPER="${REPO_ROOT}/tests/build_quality_js.sh"
  FAKE="${TEST_TMP_DIR}/fake-root"
  mkdir -p "${FAKE}/tests/python" "${FAKE}/custom_nodes"
  touch "${FAKE}/MODULE.bazel"
  cp "${REPO_ROOT}/tests/repo_root.sh" "${FAKE}/tests/repo_root.sh"
  cp "${WRAPPER}" "${FAKE}/tests/build_quality_js.sh"
  cp "${REPO_ROOT}/tests/python/_build_quality_js.py" \
    "${FAKE}/tests/python/_build_quality_js.py"
  # The whole package: _build_quality_js.py imports ez_quality.presets, which
  # runs the package __init__ and its sibling imports.
  cp -R "${REPO_ROOT}/custom_nodes/ez_quality" "${FAKE}/custom_nodes/ez_quality"
  if [[ -d "${FAKE}/custom_nodes/ez_quality/__pycache__" ]]; then
    rm -r "${FAKE}/custom_nodes/ez_quality/__pycache__"
  fi
  GENERATED="${FAKE}/custom_nodes/ez_quality/js/ez_quality_presets.js"
  # Start from "not generated yet" so every case writes or checks on its own.
  rm -f "${GENERATED}"
}

teardown() {
  teardown_repo_env
}

# Run the wrapper as Bazel would: BUILD_WORKSPACE_DIRECTORY pins the checkout.
_run_wrapper() {
  run env BUILD_WORKSPACE_DIRECTORY="${FAKE}" bash "${FAKE}/tests/build_quality_js.sh" "$@"
}

@test "build_quality_js --check passes on a fresh generated file" {
  _run_wrapper
  _run_wrapper --check
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"matches presets.py"* ]]
}

@test "build_quality_js writes the generated module" {
  [ ! -e "${GENERATED}" ]
  _run_wrapper
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"wrote custom_nodes/ez_quality/js/ez_quality_presets.js"* ]]
  [ -f "${GENERATED}" ]
  grep -q 'EZ_QUALITY_TABLE' "${GENERATED}"
  grep -q '@generated by tests/python/_build_quality_js.py' "${GENERATED}"
}

@test "build_quality_js --check fails when the generated file drifts" {
  _run_wrapper
  printf '\nexport const EZ_QUALITY_HAND_EDITED = 1;\n' >>"${GENERATED}"
  _run_wrapper --check
  [ "${status}" -eq 1 ]
  [[ "${output}" == *"is stale"* ]]
  [[ "${output}" == *"bazelisk run //tests:build_quality_js"* ]]
}

@test "build_quality_js --check fails when the file is missing" {
  _run_wrapper --check
  [ "${status}" -eq 1 ]
  [[ "${output}" == *"is stale"* ]]
}

@test "build_quality_js reports a missing python3" {
  mock_path_hide python3
  run env BUILD_WORKSPACE_DIRECTORY="${FAKE}" bash "${FAKE}/tests/build_quality_js.sh" --check
  [ "${status}" -eq 1 ]
  [[ "${output}" == *"python3 is not on PATH"* ]]
  mock_path_restore
}

@test "the checkout generated file is in sync with presets.py" {
  run env BUILD_WORKSPACE_DIRECTORY="${REPO_ROOT}" bash "${WRAPPER}" --check
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"matches presets.py"* ]]
}
