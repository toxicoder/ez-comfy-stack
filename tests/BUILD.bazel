# The mechanical "nothing goes unmapped" guard. py_test rather than sh_test:
# the BUILD files are parsed with Python's ast, and a nested `bazel query`
# would deadlock on the output-base lock of the outer invocation.
py_test(
    name = "owned_files_check",
    size = "small",
    timeout = "short",
    srcs = ["bazel_deps.py"],
    main = "bazel_deps.py",
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The doc-side twin of :owned_files_check. It reads the checkout with
# `git ls-files` the same way, so it carries the same no-sandbox tags: the
# guard is a static analysis of the tree, not a hermetic computation.
py_test(
    name = "bazel_docs_check",
    size = "small",
    timeout = "short",
    srcs = ["bazel_docs.py"],
    main = "bazel_docs.py",
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "js",
    # size small (<60s) is ample: the node:test suite runs in about 1s and
    # needs no GPU, ComfyUI, or Docker.
    size = "small",
    srcs = ["run_js.sh"],
    data = [
        "repo_root.sh",
        ":js_files",
        "//custom_nodes:sources",
        # scripts/manage.sh in runfiles is the marker tests_repo_root resolves
        # under bazel test; the suite itself reads custom_nodes **/*.js and
        # **/*.json (ez_quality overlay, ez_image mode + modes.json).
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The Quality tier codegen. presets.py is the definition and
# custom_nodes/ez_quality/js/ez_quality_presets.js is derived from it, so the
# generator gets a target of its own: docs told operators to run the raw
# `tests/python/_build_quality_js.py`, a file no BUILD file mapped.
# exec_shell, not sh_binary: the wrapper sources repo_root.sh from runfiles,
# and sh_binary only symlinks the wrapper into bazel-bin.
exec_shell(
    name = "build_quality_js",
    src = "build_quality_js.sh",
    data = [
        "build_quality_js.sh",
        "python/_build_quality_js.py",
        "repo_root.sh",
        "//custom_nodes:sources",
        "//scripts:doc_sources",
    ],
    visibility = ["//visibility:public"],
)

# Fails when the committed JS has drifted from presets.py, which is the defect
# the codegen exists to prevent (hand-editing the generated file, or editing
# presets.py and forgetting to regenerate).
sh_test(
    name = "build_quality_js_check",
    size = "small",
    timeout = "short",
    srcs = ["build_quality_js.sh"],
    args = ["--check"],
    data = [
        "python/_build_quality_js.py",
        "repo_root.sh",
        "//custom_nodes:sources",
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The operator-facing coverage sweep, in one command:
#   bazelisk test //:coverage
# It chains the 100% Python gate, Pyright + mypy, the strict shell inventory,
# the whole BATS suite, and the optional kcov report.
#
# sh_test rather than sh_binary: the contributing docs have always told the
# operator to `bazelisk test //:coverage`, and as a binary that invocation
# analyzed, built, and exited 0 without ever executing the gate. `manual` keeps
# it out of a wildcard run because //:test-fast already executes each of those
# gates as its own cached target; naming this label is what spends the single
# combined pass. `local` + `no-sandbox` for the same reason as :pytest - the
# host's pytest, pytest-cov, mypy, pyright, and bats are what run.
sh_test(
    name = "coverage",
    size = "large",
    timeout = "long",
    srcs = ["coverage.sh"],
    data = [
        ".coveragerc",
        "repo_root.sh",
        "requirements.txt",
        "run_pytest.sh",
        "shell_inventory.sh",
        "typecheck.sh",
        ":fixtures",
        ":python_tests",
        "//custom_nodes:sources",
        "//docker:sources",
        "//schemas",
        "//scripts:doc_sources",
        "//studio-ui:sources",
        "//tools:blender",
    ] + glob(["bats/*.bats"]),
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)
