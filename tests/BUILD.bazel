"""Package purpose: Hermetic BATS, node:test JS, pytest coverage, typecheck, and shell inventory."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")
load(":bats.bzl", "bats_file_tests")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "bats_tool",
    srcs = ["@bats_core//:bin/bats"],
    data = [
        "@bats_core//:libexec/bats-core/bats",
        "@bats_core//:libexec/bats-core/bats-exec-file",
        "@bats_core//:libexec/bats-core/bats-exec-suite",
        "@bats_core//:libexec/bats-core/bats-exec-test",
        "@bats_core//:libexec/bats-core/bats-format-cat",
        "@bats_core//:libexec/bats-core/bats-format-junit",
        "@bats_core//:libexec/bats-core/bats-format-pretty",
        "@bats_core//:libexec/bats-core/bats-format-tap",
        "@bats_core//:libexec/bats-core/bats-format-tap13",
        "@bats_core//:libexec/bats-core/bats-gather-tests",
        "@bats_core//:libexec/bats-core/bats-preprocess",
    ],
)

_BATS_COMMON = [
    "bats/test_helper.bash",
    "bats_runner.sh",
    ":bats_tool",
    "//scripts:doc_sources",
]

bats_file_tests(
    srcs = glob(["bats/*.bats"]),
    common_data = _BATS_COMMON,
)

exports_files(
    [
        "bats.bzl",
        "bats_runner.sh",
        "bazel_deps.py",
        "coverage.sh",
        "run_all.sh",
        "run_js.sh",
        "run_pytest.sh",
        "requirements.txt",
        "shell_inventory.sh",
        "typecheck.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "python_tests",
    srcs = glob(
        ["python/**/*.py"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "fixtures",
    srcs = glob(
        ["fixtures/**"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

# The node:test suite. run_js.sh shells out to `node --test tests/js/*.test.mjs`
# against the checkout, so without this group the five .mjs files were
# undeclared inputs: editing a test or the frontend stub could not invalidate a
# cached //tests:js pass.
filegroup(
    name = "js_files",
    srcs = glob(
        ["js/**"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

sh_test(
    name = "pytest",
    size = "large",
    # size large defaults to 900s; an explicit moderate (300s) cap was
    # killing coverage wrap-up on GitHub runners after Audio Rack splices.
    timeout = "long",
    srcs = ["run_pytest.sh"],
    data = [
        ".coveragerc",
        "repo_root.sh",
        "requirements.txt",
        ":fixtures",
        ":python_tests",
        "//custom_nodes:sources",
        "//docker:sources",
        "//schemas",
        "//scripts:doc_sources",
        "//studio-ui:sources",
        "//tools:blender",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "typecheck",
    size = "medium",
    srcs = ["typecheck.sh"],
    data = [
        "repo_root.sh",
        "requirements.txt",
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "shell_inventory",
    size = "small",
    srcs = ["shell_inventory.sh"],
    data = [
        "repo_root.sh",
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The mechanical "nothing goes unmapped" guard. py_test rather than sh_test:
# the BUILD files are parsed with Python's ast, and a nested `bazel query`
# would deadlock on the output-base lock of the outer invocation.
py_test(
    name = "owned_files_check",
    size = "small",
    timeout = "short",
    srcs = ["bazel_deps.py"],
    main = "bazel_deps.py",
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "js",
    # size small (<60s) is ample: the node:test suite runs in about 1s and
    # needs no GPU, ComfyUI, or Docker.
    size = "small",
    srcs = ["run_js.sh"],
    data = [
        "repo_root.sh",
        ":js_files",
        "//custom_nodes:sources",
        # scripts/manage.sh in runfiles is the marker tests_repo_root resolves
        # under bazel test; the suite itself reads custom_nodes **/*.js and
        # **/*.json (ez_quality overlay, ez_image mode + modes.json).
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The Quality tier codegen. presets.py is the definition and
# custom_nodes/ez_quality/js/ez_quality_presets.js is derived from it, so the
# generator gets a target of its own: docs told operators to run a raw
# `python3 tests/python/_build_quality_js.py` that no BUILD file mapped.
# exec_shell, not sh_binary: the wrapper sources repo_root.sh from runfiles,
# and sh_binary only symlinks the wrapper into bazel-bin.
exec_shell(
    name = "build_quality_js",
    src = "build_quality_js.sh",
    data = [
        "build_quality_js.sh",
        "python/_build_quality_js.py",
        "repo_root.sh",
        "//custom_nodes:sources",
        "//scripts:doc_sources",
    ],
    visibility = ["//visibility:public"],
)

# Fails when the committed JS has drifted from presets.py, which is the defect
# the codegen exists to prevent (hand-editing the generated file, or editing
# presets.py and forgetting to regenerate).
sh_test(
    name = "build_quality_js_check",
    size = "small",
    timeout = "short",
    srcs = ["build_quality_js.sh"],
    args = ["--check"],
    data = [
        "python/_build_quality_js.py",
        "repo_root.sh",
        "//custom_nodes:sources",
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "coverage",
    srcs = ["coverage.sh"],
    visibility = ["//visibility:public"],
)
