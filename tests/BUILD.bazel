# The node:test suite. run_js.sh shells out to `node --test tests/js/*.test.mjs`
# against the checkout, so without this group the five .mjs files were
# undeclared inputs: editing a test or the frontend stub could not invalidate a
# cached //tests:js pass.
filegroup(
    name = "js_files",
    srcs = [
        "js/ez_feedback.test.mjs",
        "js/ez_frontend_stub.mjs",
        "js/ez_image_mode.test.mjs",
        "js/ez_outputs.test.mjs",
        "js/harness.mjs",
        "js/quality_overlay.test.mjs",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "pytest",
    size = "large",
    # size large defaults to 900s; an explicit moderate (300s) cap was
    # killing coverage wrap-up on GitHub runners after Audio Rack splices.
    timeout = "long",
    srcs = ["run_pytest.sh"],
    data = [
        ".coveragerc",
        "repo_root.sh",
        "requirements.txt",
        ":fixtures",
        ":python_tests",
        "//custom_nodes:sources",
        "//docker:sources",
        "//schemas",
        "//scripts:doc_sources",
        "//studio-ui:sources",
        "//tools:blender",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

