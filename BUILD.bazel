"""Package purpose: Root Bazel targets for test suites, lint aggregation, docs aliases, and repo-wide entry points.

Bazel is the primary entry point: test, lint, docs, and operational scripts.

The one command that runs everything:

  bazelisk run //:everything            # bootstrap probe + graph + every gate + docs

Common entry points:

  bazelisk run //:validate              # git-aware build + test + lint + docs
  bazelisk test //:test                 # hermetic suite including docs render contract
  bazelisk test //:test-fast            # CI core (BATS + pytest + typecheck + inventory)
  bazelisk test //:test-all             # every gate, incl. manual lint + visual + compose
  bazelisk test //:lint --test_tag_filters=manual
  bazelisk test //:owned_files_check    # every tracked file is owned by a BUILD target
  bazelisk test //:bazel_docs_check     # every documented command names a target
  bazelisk run //:setup-host -- --check # host toolchain the lint gates need
  bazelisk run //:manage -- doctor
  bazelisk run //docs:serve

See docs/contribute/building-with-bazel.md.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

exports_files([
    "fix.sh",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "README.md",
    "SECURITY.md",
    "Makefile",
    "LICENSE",
    "LICENSE-MODELS.md",
    ".github/scripts/install-lint-tools.sh",
    "mypy.ini",
    "mypy-tests.ini",
    "pyrightconfig.json",
    "pyrightconfig-tests.json",
])

# Repo hygiene dotfiles. Bazel globs never match a dotfile, so these are
# listed by hand: without this group a change to .gitignore is invisible to
# every target and `git ls-files` reports the file as unmapped.
filegroup(
    name = "repo_meta",
    srcs = [
        ".env.example",
        ".gitattributes",
        ".gitignore",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "devcontainer",
    srcs = [
        ".devcontainer/.dockerignore",
        ".devcontainer/Dockerfile",
        ".devcontainer/devcontainer.json",
        ".devcontainer/doctor.sh",
        ".devcontainer/grok/config.toml",
        ".devcontainer/grok/sandbox.toml",
        ".devcontainer/post-create.sh",
        ".devcontainer/tool-versions.env",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "vscode",
    srcs = [
        ".vscode/extensions.json",
        ".vscode/launch.json",
        ".vscode/settings.json",
        ".vscode/tasks.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_workflows",
    srcs = [
        ".github/actions/setup-bazel/action.yml",
        ".github/scripts/install-lint-tools.sh",
        ".github/workflows/ci.yml",
        ".github/workflows/deploy-docs.yml",
        ".github/workflows/publish-devcontainer.yml",
        ".github/workflows/publish-image.yml",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "manage",
    actual = "//scripts:manage",
    visibility = ["//visibility:public"],
)

# The guarded operator console: one curses screen over every manage.sh verb,
# every unmanaged utility, the model tiers, the occupancy desk, the sidecars, and
# the lab lane browser. Heavy actions keep the CLI's typed confirmations and the
# headroom floors; the console adds a single-console flock and a deny-by-default
# guard on top. See docs/operate/studio-tui.mdx.
#   bazelisk run //:studio-tui
alias(
    name = "studio-tui",
    actual = "//scripts:studio-tui",
    visibility = ["//visibility:public"],
)

alias(
    name = "bats",
    actual = "//tests:bats",
    visibility = ["//visibility:public"],
)

alias(
    name = "manage_help_test",
    actual = "//scripts:manage_help_test",
    visibility = ["//visibility:public"],
)

_TEST_FAST = [
    "//scripts:manage_help_test",
    "//tests:bats",
    "//tests:bazel_docs_check",
    "//tests:build_quality_js_check",
    "//tests:js",
    "//tests:owned_files_check",
    "//tests:pytest",
    "//tests:typecheck",
    "//tests:shell_inventory",
]

test_suite(
    name = "test-fast",
    tests = _TEST_FAST,
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test",
    tests = _TEST_FAST + [
        "//docs:test_docs_site_render",
    ],
    visibility = ["//visibility:public"],
)

# Every gate in the repo, including the ones no wildcard reaches: the
# manual-tagged linters, the Playwright visual suite, and the Docker Compose
# config check. NOT hermetic and NOT fast - it needs host linters, the pinned
# docs-site npm tree, and a Docker CLI. CI runs //:test-fast and
# //:lint --test_tag_filters=manual; this is the umbrella a human runs before
# shipping a Bazel-side change.
test_suite(
    name = "test-all",
    tests = _TEST_FAST + [
        "//docker:compose_config",
        "//docs:test_docs_site_render",
        "//docs-site:suite",
        "//docs-site:visual-test",
        "//lints:buildifier",
        "//lints:js_types",
        "//lints:mypy",
        "//lints:mypy_tests",
        "//lints:pyright",
        "//lints:pyright_tests",
        "//lints:shell",
        "//lints:shfmt",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "first_party_srcs",
    srcs = [
        "AGENTS.md",
        "LICENSE",
        "LICENSE-MODELS.md",
        "MIGRATION.md",
        "Makefile",
        "SECURITY.md",
        ":ci_workflows",
        ":devcontainer",
        ":repo_meta",
        ":vscode",
        "//config:policy",
        "//custom_nodes:sources",
        "//docker:sources",
        "//docs:content",
        "//docs-site:sources",
        "//includes",
        "//schemas",
        "//scripts:doc_sources",
        "//studio-ui:sources",
        "//tests:fixtures",
        "//tests:python_tests",
        "//tools:blender",
        "//workflows:lab_graphs",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "repo_files",
    srcs = [
        ":first_party_srcs",
        ":manage",
        "//docs",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "lint",
    tags = ["lint"],
    tests = [
        "//lints:python",
        "//lints:shell_lint",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "docs-serve",
    actual = "//docs:serve",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs-build",
    actual = "//docs:docs",
    visibility = ["//visibility:public"],
)

alias(
    name = "docs",
    actual = "//docs:docs",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "fix",
    srcs = ["fix.sh"],
    visibility = ["//visibility:public"],
)

alias(
    name = "validate",
    actual = "//scripts:validate",
    visibility = ["//visibility:public"],
)

# The one entry point for "run everything". //:validate is the fast, git-aware
# slice for a working day; this is the whole sweep - host bootstrap probe,
# graph load, //:test-all, and the docs build - and it names the Bazel target
# that failed. Run it before shipping a Bazel-side change or promoting a graph.
#   bazelisk run //:everything
alias(
    name = "everything",
    actual = "//scripts:everything",
    visibility = ["//visibility:public"],
)

alias(
    name = "check",
    actual = ":validate",
    visibility = ["//visibility:public"],
)

# The coverage sweep, as a gate. This was an alias to an sh_binary, so the
# `bazelisk test //:coverage` the contributing docs print analyzed, built, and
# exited 0 without ever executing the gate. One-member test_suite, the same
# shape as :owned_files_check below: naming it runs the sweep, and Bazel caches
# the verdict like any other test.
test_suite(
    name = "coverage",
    tests = ["//tests:coverage"],
    visibility = ["//visibility:public"],
)

# Host bootstrap: bazelisk plus the lint toolchain the //:lint gates shell
# out to. This is the one target whose whole job is to make Bazel exist on a
# bare host, so it is exposed here rather than under //scripts.
#   bazelisk run //:setup-host -- --check
exec_shell(
    name = "setup-host",
    src = "//scripts:setup-host.sh",
    data = [
        "//:devcontainer",
        "//scripts:doc_sources",
        "//tests:requirements.txt",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "owned_files_check",
    tests = ["//tests:owned_files_check"],
    visibility = ["//visibility:public"],
)

# Every committed command reference names a Bazel target rather than a script.
test_suite(
    name = "bazel_docs_check",
    tests = ["//tests:bazel_docs_check"],
    visibility = ["//visibility:public"],
)
