# Local env / secrets
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# Shell coverage
coverage/
kcov-output/
*.kcov

# Docker / local state
comfy-state/
/comfy-state/
.models/

# Operator / contributor private Comfy state (never commit)
# Do not ignore the directory itself — git cannot re-include README/.gitkeep
# if the parent is ignored. Nested _user dumps stay fully ignored.
/workflows/*/_user/
/workflows/*/*/_user/
/workflows/_user/*
!/workflows/_user/.gitkeep
!/workflows/_user/README.md
**/.user-local/
# Host media bind is outside the repo; keep these in case of local overrides
/output/
/outputs/
/input/
/inputs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*~

# Docs build
site/
.cache/

# Test temp
/tmp/
test-results/
