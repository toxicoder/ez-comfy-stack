# Shell coverage
coverage/
kcov-output/
*.kcov

# Docker / local state
comfy-state/
/comfy-state/
.models/

# Operator / contributor private Comfy state (never commit)
# Do not ignore the directory itself - git cannot re-include README/.gitkeep
# if the parent is ignored. Nested _user dumps stay fully ignored.
/workflows/*/_user/
/workflows/*/*/_user/
/workflows/_user/*
!/workflows/_user/.gitkeep
!/workflows/_user/README.md
**/.user-local/
# Host media bind is outside the repo; keep these in case of local overrides
/output/
/outputs/
/input/
/inputs/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.log
*.orig
*.rej
*.bak
# Shared workspace files are tracked; keep local-only VS Code state ignored
# (.env, history, task storage, unsaved extras).
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*~

# Docs build
site/
.cache/
docs-site/node_modules/
docs-site/.next/
docs-site/.source/
docs-site/out/
docs-site/out-linux/
docs-site/.deps-linux-stamp/
docs-site/public/assets/
docs-site/tsconfig.tsbuildinfo
docs-site/tests/visual/actuals/
.venv-docs/
.turbo/
.vercel/

# Bazel build artifacts (never commit outputs)
bazel-*
.bazel/
.bazelrc.user
bazel-out/
external/

# Test temp
/tmp/
test-results/
playwright-report/
blob-report/

# Accidental git clone of a URL as a directory name
/https:/
/http:/
