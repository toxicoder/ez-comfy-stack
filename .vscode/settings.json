{
  "bazel.buildifier.executable": "buildifier",
  "bazel.codeLens.enable": false,
  "bazel.commandLine.queriesShareServer": false,
  "bazel.executable": "bazelisk",
  "bazel.workspaceTree.enable": false,
  "css.lint.unknownAtRules": "ignore",
  "editor.formatOnSave": false,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 100],
  "editor.tabSize": 2,
  "files.associations": {
    "*.bash": "shellscript",
    "*.bats": "shellscript",
    "*.bzl": "starlark",
    "BUILD.bazel": "starlark",
    "MODULE.bazel": "starlark",
    "compose*.yml": "dockercompose",
    "docker-compose*.yml": "dockercompose"
  },
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "bazel-bin": true,
    "bazel-ez-comfy-stack": true,
    "bazel-out": true,
    "bazel-testlogs": true,
    "coverage": true,
    "docs-site/.next": true,
    "docs-site/.source": true,
    "docs-site/node_modules": true,
    "docs-site/out": true,
    "docs-site/out-linux": true,
    ".venv-docs": true,
    "site": true,
    ".models": true,
    "comfy-state": true,
    "output": true,
    "outputs": true,
    "input": true,
    "inputs": true,
    "external": true,
    ".bazel": true,
    ".cache": true
  },
  "files.insertFinalNewline": true,
  "files.readonlyInclude": {
    "docs-site/out/**": true,
    "docs/generated/**": true,
    "docs/reference/workflow-nodes.md": true,
    "site/**": true
  },
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "bazel-*/**": true,
    "coverage/**": true,
    "docs-site/.next/**": true,
    "docs-site/.source/**": true,
    "docs-site/out-linux/**": true,
    "docs-site/out/**": true,
    "docs-site/public/assets/**": true,
    "docs/assets/**": true,
    "site/**": true,
    "**/.venv/**": true,
    ".venv-docs/**": true,
    "**/.ruff_cache/**": true,
    ".models/**": true,
    "comfy-state/**": true,
    "output/**": true,
    "outputs/**": true,
    "input/**": true,
    "inputs/**": true,
    "external/**": true,
    ".bazel/**": true,
    ".cache/**": true,
    "docs/generated/**": true
  },
  "git.branchProtection": ["development", "main"],
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.inputValidationSubjectLength": 72,
  "js/ts.tsdk.path": "docs-site/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.ignorePatterns": [
    "docs-site/**",
    "docs/generated/**",
    "workflows/**",
    "site/**",
    "coverage/**"
  ],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.reportingScope": "file",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "docs-site",
    "docs/generated",
    "docs/assets",
    "workflows",
    "site",
    "coverage",
    "bazel-*",
    "docs-site/node_modules",
    "docs-site/.next",
    "docs-site/out",
    "docs-site/out-linux"
  ],
  "python.analysis.indexing": true,
  "python.languageServer": "Pylance",
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": ["tests/python"],
  "python.testing.pytestEnabled": true,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.testing.unittestEnabled": false,
  "search.exclude": {
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "bazel-*": true,
    "coverage": true,
    "docs-site/.next": true,
    "docs-site/.source": true,
    "docs-site/out": true,
    "docs-site/out-linux": true,
    ".venv-docs": true,
    "site": true,
    "docs/generated": true,
    "docs/assets": true,
    ".models": true,
    "comfy-state": true,
    "output": true,
    "outputs": true,
    "input": true,
    "inputs": true,
    "external": true,
    ".bazel": true,
    ".cache": true,
    "**/.ruff_cache": true
  },
  "shellcheck.customArgs": ["-x", "--severity=warning"],
  "shellcheck.enable": true,
  "shellcheck.run": "onSave",
  "shellcheck.executablePath": "shellcheck",
  "shellcheck.ignorePatterns": {
    "**/bazel-*/**": true,
    "**/node_modules/**": true,
    "**/site/**": true,
    "**/*.bats": true
  },
  "shellcheck.useWorkspaceRootAsCwd": true,
  "shfmt.executableArgs": ["-s", "-i", "2", "-ci"],
  "shfmt.executablePath": "shfmt",
  "tailwindCSS.experimental.configFile": "docs-site/app/global.css",
  "tailwindCSS.files.exclude": [
    "**/docs/generated/**",
    "**/docs-site/.next/**",
    "**/docs-site/out/**",
    "**/docs-site/out-linux/**",
    "**/docs-site/node_modules/**"
  ],
  "tailwindCSS.includeLanguages": {
    "mdx": "html"
  },
  "yaml.schemaStore.enable": false,
  "[css]": {
    "editor.formatOnSave": false
  },
  "[github-actions-workflow]": {
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[mdx]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[starlark]": {
    "editor.defaultFormatter": "BazelBuild.vscode-bazel",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  }
}
