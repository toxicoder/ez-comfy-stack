{
  "bazel.buildifierExecutable": "buildifier",
  "bazel.executable": "bazelisk",
  "css.lint.unknownAtRules": "ignore",
  "editor.formatOnSave": false,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 100],
  "editor.tabSize": 2,
  "files.associations": {
    "*.bash": "shellscript",
    "*.bats": "shellscript",
    "*.bzl": "starlark",
    "BUILD.bazel": "starlark",
    "MODULE.bazel": "starlark",
    "WORKSPACE": "starlark",
    "WORKSPACE.bazel": "starlark",
    "compose*.yml": "dockercompose",
    "docker-compose*.yml": "dockercompose"
  },
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "bazel-bin": true,
    "bazel-ez-comfy-stack": true,
    "bazel-out": true,
    "bazel-testlogs": true,
    "coverage": true,
    "docs-site/.next": true,
    "docs-site/.source": true,
    "docs-site/node_modules": true,
    "docs-site/out": true,
    "docs-site/out-linux": true,
    ".venv-docs": true,
    "site": true
  },
  "files.insertFinalNewline": true,
  "files.readonlyInclude": {
    "docs-site/out/**": true,
    "docs/generated/**": true,
    "docs/reference/workflow-nodes.md": true,
    "site/**": true
  },
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "bazel-*/**": true,
    "coverage/**": true,
    "docs-site/.next/**": true,
    "docs-site/.source/**": true,
    "docs-site/out-linux/**": true,
    "docs-site/out/**": true,
    "docs-site/public/assets/**": true,
    "docs/assets/**": true,
    "site/**": true
  },
  "git.branchProtection": ["development", "main"],
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.inputValidationSubjectLength": 72,
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "python.analysis.indexing": true,
  "python.languageServer": "Pylance",
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": ["tests/python"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "search.exclude": {
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "bazel-*": true,
    "coverage": true,
    "docs-site/.next": true,
    "docs-site/.source": true,
    "docs-site/out": true,
    "docs-site/out-linux": true,
    ".venv-docs": true,
    "site": true
  },
  "shellcheck.customArgs": ["-x", "--severity=warning"],
  "shellcheck.enable": true,
  "shellcheck.executablePath": "shellcheck",
  "shellcheck.ignorePatterns": {
    "**/bazel-*/**": true,
    "**/node_modules/**": true,
    "**/site/**": true,
    "**/*.bats": true
  },
  "shellcheck.useWorkspaceRootAsCwd": true,
  "shfmt.executableArgs": ["-s", "-i", "2", "-ci"],
  "shfmt.executablePath": "shfmt",
  "tailwindCSS.experimental.configFile": "docs-site/app/global.css",
  "tailwindCSS.includeLanguages": {
    "mdx": "html"
  },
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsdk": "docs-site/node_modules/typescript/lib",
  "[bazel]": {
    "editor.defaultFormatter": "bazelbuild.vscode-bazel",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.formatOnSave": false
  },
  "[github-actions-workflow]": {
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[mdx]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[starlark]": {
    "editor.defaultFormatter": "bazelbuild.vscode-bazel",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  }
}
