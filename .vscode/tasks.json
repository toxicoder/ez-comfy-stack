{
  "version": "2.0.0",
  "options": {
    "env": {
      "EZ_COMFY_PROGRESS": "0",
      "HF_PROGRESS": "0",
      "LAB_HERMETIC": "1"
    }
  },
  "tasks": [
    {
      "label": "validate",
      "type": "shell",
      "command": "bazelisk run //:validate",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "test-fast",
      "type": "shell",
      "command": "bazelisk test //:test-fast",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": "bazelisk test //tests:pytest --test_output=errors",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "bazelisk test //tests:typecheck",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bazelisk test //:lint --test_tag_filters=manual",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "fix",
      "type": "shell",
      "command": "bazelisk run //:fix",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "doctor",
      "type": "shell",
      "command": "bazelisk run //:manage -- doctor",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "docs",
      "type": "shell",
      "command": "bazelisk run //docs:docs",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    },
    {
      "label": "docs-serve",
      "type": "shell",
      "command": "bazelisk run //docs:serve",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always",
        "showReuseMessage": false
      }
    }
  ]
}
