# Copy and source, or export these before ./scripts/manage.sh farm-h3.
# Do not commit real hostnames with secrets. Management SSH is NOT the 200 GbE fabric.

# Management / SSH network (not the 200 GbE fabric)
SPARK_HOSTS=spark-0.local,spark-1.local,spark-2.local
SPARK_USER=nvidia

# ComfyUI HTTP per node (one instance each)
SPARK_COMFY_URLS=http://spark-0.local:8188,http://spark-1.local:8188,http://spark-2.local:8188

# High-bandwidth fabric IPs (ConnectX-7 / RoCE). Used for NFS and shot-relay copies.
SPARK_FABRIC_IPS=10.0.0.1,10.0.0.2,10.0.0.3

# Shared model + artifact root. Must be the same path on every node.
MODELS_DIR=/mnt/models
FARM_SHARE=/mnt/models/h3-farm
